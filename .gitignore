.vite/
const express = require('express');
const app = express();
const PORT = 5000;
app.use(express.json()); // Essential JSON parser
class DataEngine {
    process(arr) {
        if (!arr || !Array.isArray(arr)) return [];
        // Deduplicate with Set, convert back to Array, and sort numerically
        return Array.from(new Set(arr)).sort((a, b) => a - b).slice(-10); 
    }
}
const engine = new DataEngine();

// getroute
app.get('/api/data', (req, res) => {
    try {
        const raw = req.query.numbers;
        if (!raw) return res.status(400).json({ error: "Missing numbers" });
        
        const parsed = raw.split(',').map(Number);
        return res.status(200).json({ result: engine.process(parsed) });
    } catch (err) {
        return res.status(500).json({ error: "Server error" });
    }
});
//post route
app.post('/api/data', (req, res) => {
    try {
        const bodyData = req.body.data;
        if (!bodyData) return res.status(400).json({ error: "Missing body data" });

        return res.status(201).json({ result: engine.process(bodyData) });
    } catch (err) {
        return res.status(500).json({ error: "Server error" });
    }
});

app.listen(PORT, () => console.log(`Run on ${PORT}`));

// For your GET tests: http://localhost:5000/api/data?numbers=5,1,9,2

// For your POST tests: http://localhost:5000/api/data
//test post
// {
//     "data": [88, 11, 44, 11, 88]
// }
